// ============================================================
// Gold Multi-Timeframe Professional Trading System v2.0
// Advanced Entry/Exit Logic with Timeframe-Specific Parameters
// © 2024 - Professional Grade Trading System
// Version: 2.0 (Full Professional Upgrade)
// ============================================================
//@version=5
indicator("Gold MultiTF Pro v2.0 [HTF Confirmation + MTF Entry/Exit]", overlay=true, max_labels_count=500, max_lines_count=500)

// ============================================================
// SECTION 1: ENHANCED INPUTS - SEPARATED BY TIMEFRAME
// ============================================================

// --- TREND FILTER INPUTS ---
emaFastLen   = input.int(21, "EMA Fast Length", minval=5, maxval=200, group="Trend Analysis")
emaSlowLen   = input.int(50, "EMA Slow Length", minval=10, maxval=500, group="Trend Analysis")
rsiLen       = input.int(14, "RSI Length", minval=5, maxval=50, group="Trend Analysis")
rsiOverbought = input.int(70, "RSI Overbought Level", minval=50, maxval=100, group="Trend Analysis")
rsiOversold = input.int(30, "RSI Oversold Level", minval=0, maxval=50, group="Trend Analysis")

// --- ATR & VOLATILITY ---
atrLen       = input.int(14, "ATR Length", minval=5, maxval=50, group="Volatility")
atrVolMul    = input.float(1.5, "ATR Volatility Multiplier", minval=0.5, maxval=3.0, step=0.1, group="Volatility")

// --- SWING DETECTION ---
swingLen     = input.int(20, "Swing High/Low Lookback", minval=5, maxval=100, group="Swing Detection")

// --- SUPPORT/RESISTANCE ---
pivotLen     = input.int(15, "Pivot Lookback for S/R", minval=5, maxval=50, group="Support/Resistance")
srProxATRmul = input.float(0.5, "S/R 'Near Zone' Distance (x ATR)", minval=0.1, maxval=2.0, step=0.1, group="Support/Resistance")
showSRLines  = input.bool(true, "Show S/R Lines on Chart", group="Support/Resistance")
maxSRLines   = input.int(4, "Max S/R Lines to Keep (each side)", minval=1, maxval=10, group="Support/Resistance")
srQualityMin = input.float(2, "Minimum S/R Zone Touches", minval=1, maxval=5, group="Support/Resistance")

// --- TIMEFRAME-SPECIFIC RISK PARAMETERS ---
// M5 Parameters
riskRewardM5 = input.float(1.5, "Risk:Reward Ratio (M5)", minval=0.5, maxval=3.0, step=0.5, group="Risk Parameters - M5")
slBufferM5   = input.float(0.4, "SL Buffer Factor (M5)", minval=0.1, maxval=1.0, step=0.1, group="Risk Parameters - M5")
tpMultiplierM5 = input.float(1.0, "TP Multiplier (M5)", minval=0.5, maxval=2.0, step=0.1, group="Risk Parameters - M5")

// M15 Parameters
riskRewardM15 = input.float(2.0, "Risk:Reward Ratio (M15)", minval=0.5, maxval=3.0, step=0.5, group="Risk Parameters - M15")
slBufferM15  = input.float(0.5, "SL Buffer Factor (M15)", minval=0.1, maxval=1.0, step=0.1, group="Risk Parameters - M15")
tpMultiplierM15 = input.float(1.2, "TP Multiplier (M15)", minval=0.5, maxval=2.0, step=0.1, group="Risk Parameters - M15")

// M30 Parameters
riskRewardM30 = input.float(2.5, "Risk:Reward Ratio (M30)", minval=0.5, maxval=3.0, step=0.5, group="Risk Parameters - M30")
slBufferM30  = input.float(0.6, "SL Buffer Factor (M30)", minval=0.1, maxval=1.0, step=0.1, group="Risk Parameters - M30")
tpMultiplierM30 = input.float(1.5, "TP Multiplier (M30)", minval=0.5, maxval=2.0, step=0.1, group="Risk Parameters - M30")

// H1 Parameters
riskRewardH1 = input.float(3.0, "Risk:Reward Ratio (H1)", minval=0.5, maxval=3.0, step=0.5, group="Risk Parameters - H1")
slBufferH1   = input.float(0.7, "SL Buffer Factor (H1)", minval=0.1, maxval=1.0, step=0.1, group="Risk Parameters - H1")
tpMultiplierH1 = input.float(1.8, "TP Multiplier (H1)", minval=0.5, maxval=2.0, step=0.1, group="Risk Parameters - H1")

// H4 Parameters
riskRewardH4 = input.float(3.5, "Risk:Reward Ratio (H4)", minval=0.5, maxval=3.0, step=0.5, group="Risk Parameters - H4")
slBufferH4   = input.float(0.8, "SL Buffer Factor (H4)", minval=0.1, maxval=1.0, step=0.1, group="Risk Parameters - H4")
tpMultiplierH4 = input.float(2.0, "TP Multiplier (H4)", minval=0.5, maxval=2.0, step=0.1, group="Risk Parameters - H4")

// --- SIGNAL THRESHOLDS ---
strongLevel  = input.float(60, "Strong Signal Threshold (%)", minval=30, maxval=100, group="Signal Quality")
goodLevel    = input.float(40, "Good Signal Threshold (%)", minval=10, maxval=70, group="Signal Quality")
weakLevel    = input.float(15, "Weak Signal Threshold (%)", minval=1, maxval=50, group="Signal Quality")

// --- ENTRY/EXIT QUALITY FILTERS ---
requireHTFConfirm = input.bool(true, "Require HTF Confirmation", group="Entry Filters")
requireCandleConf = input.bool(true, "Require Candlestick Confirmation", group="Entry Filters")
requireSRConf = input.bool(true, "Require S/R Zone Proximity", group="Entry Filters")
enableTrailingStop = input.bool(true, "Enable Trailing Stop Logic", group="Exit Management")
trailingStopPercent = input.float(0.5, "Trailing Stop % of Risk", minval=0.1, maxval=2.0, step=0.1, group="Exit Management")

// --- DISPLAY OPTIONS ---
showTimeframeTable = input.bool(true, "Show Timeframe Table", group="Display")
showEntryLabel = input.bool(true, "Show Entry/Exit Labels", group="Display")
showAlerts = input.bool(true, "Enable Alerts", group="Display")

// ============================================================
// SECTION 2: CORE CALCULATION FUNCTIONS
// ============================================================

// Function: Calculate Multi-Timeframe Bias Score (-4 to +4)
f_bias(tf) =>
    [macdLineRaw, signalLineRaw, _] = ta.macd(close, 12, 26, 9)
    [c, eFast, eSlow, rsiVal, macdLine, signalLine] = request.security(syminfo.tickerid, tf,
         [close, ta.ema(close, emaFastLen), ta.ema(close, emaSlowLen), ta.rsi(close, rsiLen),
          macdLineRaw, signalLineRaw], lookahead=barmerge.lookahead_off)
    
    score = 0.0
    score := score + (eFast > eSlow ? 1 : -1)
    score := score + (c > eFast ? 1 : -1)
    score := score + (rsiVal > 50 ? 1 : -1)
    score := score + (macdLine > signalLine ? 1 : -1)
    score

// Function: Get Higher Timeframe Confirmation
f_htfConfirm(tf) =>
    [c, eFast, eSlow, rsiVal] = request.security(syminfo.tickerid, tf,
         [close, ta.ema(close, emaFastLen), ta.ema(close, emaSlowLen), ta.rsi(close, rsiLen)],
         lookahead=barmerge.lookahead_off)
    
    bullConfirm = eFast > eSlow and c > eFast and rsiVal > rsiOversold
    bearConfirm = eFast < eSlow and c < eFast and rsiVal < rsiOverbought
    
    [bullConfirm, bearConfirm, rsiVal]

// Function: Calculate Market Regime (Trend vs Range)
f_marketRegime() =>
    // Using ADX concept - higher volatility spread
    atrVal = ta.atr(atrLen)
    emaSpread = ta.ema(close, emaFastLen) - ta.ema(close, emaSlowLen)
    regimeStrength = math.abs(emaSpread) / atrVal
    
    isTrending = regimeStrength > 1.0  // Strong trend
    isRanging = regimeStrength < 0.5   // Consolidation
    [isTrending, isRanging, regimeStrength]

// Function: Nearest Support/Resistance Above & Below
f_nearestAbove(arr, ref) =>
    result = float(na)
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            v = array.get(arr, i)
            if v > ref and (na(result) or v < result)
                result := v
    result

f_nearestBelow(arr, ref) =>
    result = float(na)
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            v = array.get(arr, i)
            if v < ref and (na(result) or v > result)
                result := v
    result

// Function: Candlestick Pattern Detection
f_candlePattern() =>
    body = math.abs(close - open)
    range_ = high - low
    upperWick = high - math.max(close, open)
    lowerWick = math.min(close, open) - low
    
    bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
    bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
    hammer = lowerWick > body * 2 and upperWick < body * 0.6 and body > 0
    shootStar = upperWick > body * 2 and lowerWick < body * 0.6 and body > 0
    doji = body <= range_ * 0.1 and range_ > 0
    
    score = 0.0
    score := score + (bullEngulf ? 2 : 0)
    score := score + (hammer and not bullEngulf ? 1 : 0)
    score := score - (bearEngulf ? 2 : 0)
    score := score - (shootStar and not bearEngulf ? 1 : 0)
    
    candleName = bullEngulf ? "Bullish Engulfing" :
                 bearEngulf ? "Bearish Engulfing" :
                 hammer ? "Hammer" :
                 shootStar ? "Shooting Star" :
                 doji ? "Doji" : "None"
    
    [score, candleName, bullEngulf, bearEngulf, hammer, shootStar, doji]

// ============================================================
// SECTION 3: MULTI-TIMEFRAME BIAS CALCULATION
// ============================================================

biasH4  = f_bias("240")
biasH1  = f_bias("60")
biasM30 = f_bias("30")
biasM15 = f_bias("15")
biasM5  = f_bias("5")

// HTF Confirmations (for entry gating)
[bullHTFH4, bearHTFH4, rsiH4] = f_htfConfirm("240")
[bullHTFH1, bearHTFH1, rsiH1] = f_htfConfirm("60")
[bullHTFM30, bearHTFM30, rsiM30] = f_htfConfirm("30")

// Market Regime Detection
[isTrending, isRanging, regimeStrength] = f_marketRegime()

// ============================================================
// SECTION 4: SUPPORT/RESISTANCE ZONES WITH QUALITY SCORING
// ============================================================

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float[] resistanceLevels = array.new_float(0)
var float[] supportLevels = array.new_float(0)
var int[] resistanceTouches = array.new_int(0)
var int[] supportTouches = array.new_int(0)
var line[] resistanceLines = array.new_line(0)
var line[] supportLines = array.new_line(0)

// Count touches for S/R quality
if not na(ph)
    foundExisting = false
    for i = 0 to array.size(resistanceLevels) - 1
        if math.abs(array.get(resistanceLevels, i) - ph) < atrVal * 0.3
            array.set(resistanceTouches, i, array.get(resistanceTouches, i) + 1)
            foundExisting := true
            break
    
    if not foundExisting
        array.push(resistanceLevels, ph)
        array.push(resistanceTouches, 1)
        if showSRLines
            newResLine = line.new(bar_index[pivotLen], ph, bar_index, ph, xloc=xloc.bar_index, 
                                  extend=extend.right, color=color.new(color.red, 20), width=1, style=line.style_dashed)
            array.push(resistanceLines, newResLine)
    
    if array.size(resistanceLevels) > maxSRLines
        array.shift(resistanceLevels)
        array.shift(resistanceTouches)
        if array.size(resistanceLines) > 0
            line.delete(array.shift(resistanceLines))

if not na(pl)
    foundExisting = false
    for i = 0 to array.size(supportLevels) - 1
        if math.abs(array.get(supportLevels, i) - pl) < atrVal * 0.3
            array.set(supportTouches, i, array.get(supportTouches, i) + 1)
            foundExisting := true
            break
    
    if not foundExisting
        array.push(supportLevels, pl)
        array.push(supportTouches, 1)
        if showSRLines
            newSupLine = line.new(bar_index[pivotLen], pl, bar_index, pl, xloc=xloc.bar_index, 
                                  extend=extend.right, color=color.new(color.green, 20), width=1, style=line.style_dashed)
            array.push(supportLines, newSupLine)
    
    if array.size(supportLevels) > maxSRLines
        array.shift(supportLevels)
        array.shift(supportTouches)
        if array.size(supportLines) > 0
            line.delete(array.shift(supportLines))

nearestRes = f_nearestAbove(resistanceLevels, close)
nearestSup = f_nearestBelow(supportLevels, close)

atrVal = ta.atr(atrLen)
proxDist = atrVal * srProxATRmul

nearSupport = not na(nearestSup) and (close - nearestSup) <= proxDist
nearResistance = not na(nearestRes) and (nearestRes - close) <= proxDist

srScore = 0.0
srScore := srScore + (nearSupport ? 1.5 : 0)
srScore := srScore - (nearResistance ? 1.5 : 0)

// ============================================================
// SECTION 5: CANDLESTICK PATTERN ANALYSIS
// ============================================================

[candleScore, candleName, bullEngulf, bearEngulf, hammer, shootStar, doji] = f_candlePattern()

// ============================================================
// SECTION 6: COMPOSITE CONFLUENCE SCORE (PROFESSIONAL)
// ============================================================

wH4 = 2.0
wH1 = 1.8
wM30 = 1.5
wM15 = 1.2
wM5 = 1.0
wCandle = 1.5
wSR = 1.2
wRegime = 0.8

totalScore = biasH4*wH4 + biasH1*wH1 + biasM30*wM30 + biasM15*wM15 + biasM5*wM5 + 
             candleScore*wCandle + srScore*wSR + (isTrending ? regimeStrength * wRegime : -regimeStrength * wRegime * 0.5)

maxScore = 4*(wH4 + wH1 + wM30 + wM15 + wM5) + 2*wCandle + 1.5*wSR + wRegime
normScore = totalScore / maxScore * 100

signal = normScore > strongLevel ? "STRONG BUY" :
         normScore > goodLevel ? "BUY" :
         normScore < -strongLevel ? "STRONG SELL" :
         normScore < -goodLevel ? "SELL" :
         normScore < -weakLevel ? "WEAK SELL" :
         normScore > weakLevel ? "WEAK BUY" : "NEUTRAL"

sigColor = normScore > goodLevel ? color.new(color.green, 0) : 
           normScore > weakLevel ? color.new(color.lime, 30) :
           normScore < -goodLevel ? color.new(color.red, 0) :
           normScore < -weakLevel ? color.new(color.maroon, 30) : color.gray

// ============================================================
// SECTION 7: TIMEFRAME-SPECIFIC ENTRY/EXIT LOGIC
// ============================================================

// Determine current timeframe
currentTF = timeframe.period
isCurrM5 = currentTF == "5"
isCurrM15 = currentTF == "15"
isCurrM30 = currentTF == "30"
isCurrH1 = currentTF == "60"
isCurrH4 = currentTF == "240"

// Function: Calculate Entry/Exit for specific timeframe
f_tfEntry(tf, riskReward, slBuffer, tpMult, htfBull, htfBear) =>
    [tfC, tfEFast, tfESlow, tfRsi] = request.security(syminfo.tickerid, tf,
         [close, ta.ema(close, emaFastLen), ta.ema(close, emaSlowLen), ta.rsi(close, rsiLen)],
         lookahead=barmerge.lookahead_off)
    
    tfSwingHigh = request.security(syminfo.tickerid, tf, ta.highest(high, swingLen), lookahead=barmerge.lookahead_off)
    tfSwingLow = request.security(syminfo.tickerid, tf, ta.lowest(low, swingLen), lookahead=barmerge.lookahead_off)
    tfATR = request.security(syminfo.tickerid, tf, ta.atr(atrLen), lookahead=barmerge.lookahead_off)
    
    // Entry Price
    entryPrice = tfC
    
    // Stop Loss Calculation
    slBuy = tfSwingLow - tfATR * slBuffer
    slSell = tfSwingHigh + tfATR * slBuffer
    
    // Take Profit Calculation
    tpBuy = entryPrice + (entryPrice - slBuy) * riskReward * tpMult
    tpSell = entryPrice - (slSell - entryPrice) * riskReward * tpMult
    
    // Risk Amount
    riskBuy = entryPrice - slBuy
    riskSell = slSell - entryPrice
    
    [entryPrice, slBuy, slSell, tpBuy, tpSell, riskBuy, riskSell, tfRsi]

// Get entry/exit for current timeframe
[entryPrice, slBuy, slSell, tpBuy, tpSell, riskBuy, riskSell, currRsi] = 
    isCurrM5 ? f_tfEntry("5", riskRewardM5, slBufferM5, tpMultiplierM5, bullHTFH1, bearHTFH1) :
    isCurrM15 ? f_tfEntry("15", riskRewardM15, slBufferM15, tpMultiplierM15, bullHTFM30, bearHTFM30) :
    isCurrM30 ? f_tfEntry("30", riskRewardM30, slBufferM30, tpMultiplierM30, bullHTFH1, bearHTFH1) :
    isCurrH1 ? f_tfEntry("60", riskRewardH1, slBufferH1, tpMultiplierH1, bullHTFH4, bearHTFH4) :
    isCurrH4 ? f_tfEntry("240", riskRewardH4, slBufferH4, tpMultiplierH4, true, true) :
    [entryPrice, slBuy, slSell, tpBuy, tpSell, riskBuy, riskSell, currRsi]

// Entry Quality Checks
htfConfCheck = requireHTFConfirm ? (normScore > 0 ? bullHTFH1 : bearHTFH1) : true
candleConfCheck = requireCandleConf ? candleScore != 0 : true
srConfCheck = requireSRConf ? (normScore > 0 ? nearSupport : nearResistance) : true

// Determine if entry is valid
buySignalValid = normScore > goodLevel and htfConfCheck and candleConfCheck and isTrending
sellSignalValid = normScore < -goodLevel and htfConfCheck and candleConfCheck and isTrending

// Validate entry did not trigger yet
buyTriggered = buySignalValid and normScore[1] <= goodLevel
sellTriggered = sellSignalValid and normScore[1] >= -goodLevel

// ============================================================
// SECTION 8: TRAILING STOP LOGIC
// ============================================================

var float trailingStopLevel = na
var bool isLongActive = false
var bool isShortActive = false
var float entryLevelActive = na

if buyTriggered
    isLongActive := true
    isShortActive := false
    entryLevelActive := entryPrice
    trailingStopLevel := slBuy

if sellTriggered
    isShortActive := true
    isLongActive := false
    entryLevelActive := entryPrice
    trailingStopLevel := slSell

// Update trailing stop
if enableTrailingStop
    if isLongActive and close > entryLevelActive
        newTrail = close - (riskBuy * trailingStopPercent)
        trailingStopLevel := math.max(trailingStopLevel, newTrail)
    
    if isShortActive and close < entryLevelActive
        newTrail = close + (riskSell * trailingStopPercent)
        trailingStopLevel := math.min(trailingStopLevel, newTrail)

// Exit conditions
exitLong = isLongActive and (close <= trailingStopLevel or close >= tpBuy)
exitShort = isShortActive and (close >= trailingStopLevel or close <= tpSell)

if exitLong
    isLongActive := false
    trailingStopLevel := na
    entryLevelActive := na

if exitShort
    isShortActive := false
    trailingStopLevel := na
    entryLevelActive := na

// ============================================================
// SECTION 9: INFO TABLE - COMPREHENSIVE TIMEFRAME DISPLAY
// ============================================================

var table infoTable = table.new(position.top_right, 3, 12, bgcolor=color.new(color.black, 15), 
                                border_width=2, border_color=color.gray)

f_biasLabel(b) => b > 2 ? "Strong Bull" : b > 0 ? "Bullish" : b < -2 ? "Strong Bear" : b < 0 ? "Bearish" : "Neutral"
f_biasColor(b) => b > 2 ? color.new(color.lime, 0) : b > 0 ? color.green : b < -2 ? color.new(color.maroon, 0) : b < 0 ? color.red : color.gray
f_signalColor(s) => s == "STRONG BUY" ? color.new(color.lime, 10) : s == "BUY" ? color.new(color.green, 20) : 
                    s == "STRONG SELL" ? color.new(color.maroon, 10) : s == "SELL" ? color.new(color.red, 20) : color.gray

if showTimeframeTable and barstate.islast
    // Headers
    table.cell(infoTable, 0, 0, "Timeframe", text_color=color.white, bgcolor=color.new(color.gray, 40), text_size=size.small)
    table.cell(infoTable, 1, 0, "Bias", text_color=color.white, bgcolor=color.new(color.gray, 40), text_size=size.small)
    table.cell(infoTable, 2, 0, "RSI", text_color=color.white, bgcolor=color.new(color.gray, 40), text_size=size.small)
    
    // H4 Row
    table.cell(infoTable, 0, 1, "H4", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, f_biasLabel(biasH4), text_color=f_biasColor(biasH4), text_size=size.small)
    table.cell(infoTable, 2, 1, str.tostring(rsiH4, "#.#"), text_color=color.yellow, text_size=size.small)
    
    // H1 Row
    table.cell(infoTable, 0, 2, "H1", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, f_biasLabel(biasH1), text_color=f_biasColor(biasH1), text_size=size.small)
    table.cell(infoTable, 2, 2, str.tostring(rsiH1, "#.#"), text_color=color.yellow, text_size=size.small)
    
    // M30 Row
    table.cell(infoTable, 0, 3, "M30", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, f_biasLabel(biasM30), text_color=f_biasColor(biasM30), text_size=size.small)
    table.cell(infoTable, 2, 3, str.tostring(rsiM30, "#.#"), text_color=color.yellow, text_size=size.small)
    
    // M15 Row
    table.cell(infoTable, 0, 4, "M15", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, f_biasLabel(biasM15), text_color=f_biasColor(biasM15), text_size=size.small)
    table.cell(infoTable, 2, 4, str.tostring(currRsi, "#.#"), text_color=color.yellow, text_size=size.small)
    
    // M5 Row
    table.cell(infoTable, 0, 5, "M5", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 5, f_biasLabel(biasM5), text_color=f_biasColor(biasM5), text_size=size.small)
    table.cell(infoTable, 2, 5, str.tostring(currRsi, "#.#"), text_color=color.yellow, text_size=size.small)
    
    // Candle Pattern Row
    table.cell(infoTable, 0, 6, "Candle", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 6, candleName, text_color=candleScore > 0 ? color.green : candleScore < 0 ? color.red : color.gray, text_size=size.small)
    table.cell(infoTable, 2, 6, str.tostring(candleScore, "+#.#;-#.#"), text_color=candleScore > 0 ? color.green : color.red, text_size=size.small)
    
    // S/R Status
    table.cell(infoTable, 0, 7, "Support", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 7, nearSupport ? "YES" : "No", text_color=nearSupport ? color.green : color.gray, text_size=size.small)
    table.cell(infoTable, 2, 7, nearSupport ? str.tostring(nearestSup, "#.##") : "—", text_color=color.orange, text_size=size.small)
    
    table.cell(infoTable, 0, 8, "Resistance", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 8, nearResistance ? "YES" : "No", text_color=nearResistance ? color.red : color.gray, text_size=size.small)
    table.cell(infoTable, 2, 8, nearResistance ? str.tostring(nearestRes, "#.##") : "—", text_color=color.orange, text_size=size.small)
    
    // Regime Status
    table.cell(infoTable, 0, 9, "Regime", text_color=color.white, text_size=size.small)
    regimeLabel = isTrending ? "TREND" : isRanging ? "RANGE" : "MIXED"
    regimeCol = isTrending ? color.green : isRanging ? color.orange : color.gray
    table.cell(infoTable, 1, 9, regimeLabel, text_color=regimeCol, text_size=size.small)
    table.cell(infoTable, 2, 9, str.tostring(regimeStrength, "#.##"), text_color=regimeCol, text_size=size.small)
    
    // Score Row
    table.cell(infoTable, 0, 10, "Score", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 10, str.tostring(normScore, "+#.#;-#.#") + "%", text_color=color.yellow, text_size=size.small)
    
    // Signal Row
    table.cell(infoTable, 0, 11, "Signal", text_color=color.white, bgcolor=color.new(color.gray, 40), text_size=size.small)
    table.cell(infoTable, 1, 11, signal, text_color=f_signalColor(signal), bgcolor=f_signalColor(signal), text_size=size.small)
    table.cell(infoTable, 2, 11, isLongActive ? "LONG" : isShortActive ? "SHORT" : "—", 
               text_color=isLongActive ? color.green : isShortActive ? color.red : color.gray, text_size=size.small)

// ============================================================
// SECTION 10: ENTRY/EXIT LABELS WITH TF-SPECIFIC DETAILS
// ============================================================

if showEntryLabel and barstate.islast
    if buyTriggered
        labelText = "BUY [" + currentTF + "]\n" +
                   "Entry: " + str.tostring(entryPrice, "#.##") + "\n" +
                   "SL: " + str.tostring(slBuy, "#.##") + "\n" +
                   "TP: " + str.tostring(tpBuy, "#.##") + "\n" +
                   "Risk: " + str.tostring(riskBuy, "#.####") + "\n" +
                   "R:R = 1:" + str.tostring(riskRewardM5 if isCurrM5 else riskRewardM15 if isCurrM15 else riskRewardM30 if isCurrM30 else riskRewardH1 if isCurrH1 else riskRewardH4, "#.#")
        
        label.new(bar_index, low - atrVal*0.5, labelText, style=label.style_label_up, 
                 color=color.new(color.green, 20), textcolor=color.white, size=size.small)
    
    if sellTriggered
        labelText = "SELL [" + currentTF + "]\n" +
                   "Entry: " + str.tostring(entryPrice, "#.##") + "\n" +
                   "SL: " + str.tostring(slSell, "#.##") + "\n" +
                   "TP: " + str.tostring(tpSell, "#.##") + "\n" +
                   "Risk: " + str.tostring(riskSell, "#.####") + "\n" +
                   "R:R = 1:" + str.tostring(riskRewardM5 if isCurrM5 else riskRewardM15 if isCurrM15 else riskRewardM30 if isCurrM30 else riskRewardH1 if isCurrH1 else riskRewardH4, "#.#")
        
        label.new(bar_index, high + atrVal*0.5, labelText, style=label.style_label_down, 
                 color=color.new(color.red, 20), textcolor=color.white, size=size.small)

// ============================================================
// SECTION 11: VISUAL PLOTS
// ============================================================

// EMA Plots (Current Timeframe)
plot(ta.ema(close, emaFastLen), color=color.new(color.blue, 20), title="EMA Fast", linewidth=2)
plot(ta.ema(close, emaSlowLen), color=color.new(color.orange, 20), title="EMA Slow", linewidth=2)

// Entry/Exit Points
plotshape(buyTriggered, style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), 
         size=size.large, title="Buy Signal")
plotshape(sellTriggered, style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), 
         size=size.large, title="Sell Signal")

// Candle Patterns
plotshape(bullEngulf and not buyTriggered, style=shape.circle, location=location.belowbar, 
         color=color.new(color.lime, 40), size=size.small, title="Bullish Engulfing")
plotshape(bearEngulf and not sellTriggered, style=shape.circle, location=location.abovebar, 
         color=color.new(color.maroon, 40), size=size.small, title="Bearish Engulfing")
plotshape(hammer and not buyTriggered, style=shape.diamond, location=location.belowbar, 
         color=color.new(color.green, 50), size=size.tiny, title="Hammer")
plotshape(shootStar and not sellTriggered, style=shape.diamond, location=location.abovebar, 
         color=color.new(color.red, 50), size=size.tiny, title="Shooting Star")

// Trailing Stop Visualization
plot(isLongActive ? trailingStopLevel : na, color=color.new(color.green, 50), style=plot.style_linebr, 
     linewidth=2, title="Long Trailing Stop")
plot(isShortActive ? trailingStopLevel : na, color=color.new(color.red, 50), style=plot.style_linebr, 
     linewidth=2, title="Short Trailing Stop")

// Entry Price Level
plot(isLongActive or isShortActive ? entryLevelActive : na, color=color.new(color.yellow, 40), 
     style=plot.style_linebr, linewidth=1, title="Active Entry Level")

// ============================================================
// SECTION 12: ALERT CONDITIONS (PROFESSIONAL)
// ============================================================

if showAlerts
    alertcondition(buyTriggered, title="🟢 BUY SIGNAL [" + currentTF + "]", 
                  message="Gold Pro v2.0: BUY TRIGGERED on " + currentTF + 
                         "\nEntry: " + str.tostring(entryPrice, "#.##") + 
                         " | SL: " + str.tostring(slBuy, "#.##") + 
                         " | TP: " + str.tostring(tpBuy, "#.##"))
    
    alertcondition(sellTriggered, title="🔴 SELL SIGNAL [" + currentTF + "]", 
                  message="Gold Pro v2.0: SELL TRIGGERED on " + currentTF + 
                         "\nEntry: " + str.tostring(entryPrice, "#.##") + 
                         " | SL: " + str.tostring(slSell, "#.##") + 
                         " | TP: " + str.tostring(tpSell, "#.##"))
    
    alertcondition(exitLong, title="🟡 CLOSE LONG [" + currentTF + "]", 
                  message="Gold Pro v2.0: CLOSE LONG on " + currentTF + 
                         "\nExit Price: " + str.tostring(close, "#.##"))
    
    alertcondition(exitShort, title="🟡 CLOSE SHORT [" + currentTF + "]", 
                  message="Gold Pro v2.0: CLOSE SHORT on " + currentTF + 
                         "\nExit Price: " + str.tostring(close, "#.##"))

// ============================================================
// SECTION 13: DEBUGGING INFO (Optional - Comment out for production)
// ============================================================

var label debugLabel = na
if barstate.islast and showEntryLabel
    debugText = "TF: " + currentTF + 
               "\nScore: " + str.tostring(normScore, "+#.#") + "%" +
               "\nHTF Bull: " + str.tostring(bullHTFH1) +
               "\nCandle Score: " + str.tostring(candleScore, "+#.#") +
               "\nTrending: " + str.tostring(isTrending) +
               "\nRegimeStr: " + str.tostring(regimeStrength, "#.##")
    
    if not na(debugLabel)
        label.delete(debugLabel)
    
    debugLabel := label.new(bar_index - 5, high + atrVal*2, debugText, 
                           style=label.style_label_left, color=color.new(color.gray, 30), 
                           textcolor=color.white, size=size.tiny)

// ============================================================
// END OF SCRIPT
// ============================================================
